{
    "name": "beavarr",
    "version": "0.1.0",
    "description": "LLM armed *arr stack watch experience",
    "keywords": [
        "ai",
        "arr-stack",
        "bun",
        "hono",
        "langchain",
        "llm",
        "monorepo",
        "react",
        "turbo",
        "vite"
    ],
    "homepage": "https://github.com/kid1412621/beavarr",
    "license": "MIT",
    "author": "NanoNova",
    "workspaces": [
        "./server",
        "./client",
        "./shared"
    ],
    "scripts": {
        "dev": "turbo dev",
        "dev:client": "turbo dev --filter=client",
        "dev:server": "turbo dev --filter=server",
        "build": "turbo build",
        "build:client": "turbo build --filter=client",
        "build:server": "turbo build --filter=server",
        "build:single": "bun run build && bun run copy:static && bun run build:server",
        "copy:static": "rm -rf server/static && cp -r client/dist server/static",
        "start:single": "cd server && bun dist/index.js",
        "build:docker": "docker build -t beavarr .",
        "start:docker": "docker run -p 4242:4242 --name beavarr --rm beavarr",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "type-check": "turbo type-check",
        "test": "turbo test",
        "postinstall": "turbo build --filter=shared --filter=server",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "bun-types": "^1.3.9",
        "oxfmt": "^0.28.0",
        "oxlint": "^1.50.0",
        "turbo": "^2.8.10"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.9"
}