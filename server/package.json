{
    "name": "server",
    "version": "0.0.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc && bun build ./src/index.ts --target bun --minify --outfile ./dist/index.js",
        "dev": "bun --watch run src/index.ts & tsc --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:check": "drizzle-kit check",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@langchain/core": "^1.1.27",
        "@langchain/openai": "^1.2.9",
        "@logtape/drizzle-orm": "^2.0.2",
        "@logtape/hono": "^2.0.2",
        "@logtape/logtape": "^2.0.2",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.12.2",
        "langchain": "^1.2.26",
        "shared": "workspace:*",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "drizzle-kit": "^0.31.9"
    }
}