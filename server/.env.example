# Beavarr environment configuration
# Copy this file to .env and adjust the values as needed.
# Bun loads .env automatically — no extra setup required.

# ── Server ────────────────────────────────────────────────────────────────────

# Port the server listens on (default: 4242)
PORT=4242

# ── *arr connection settings ──────────────────────────────────────────────────

# Timeout in milliseconds for Radarr / Sonarr connection tests.
# Increase this if your *arr instances are running on slow hardware or a remote
# host. Decrease it if you want faster failure detection.
# Default: 5000
ARR_CONNECTION_TIMEOUT_MS=5000
